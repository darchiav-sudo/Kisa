{
  "expo": {
    "name": "Kisa",
    "slug": "kisa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kisa",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kisa.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#04060c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.kisa.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#04060c"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kisa uses your location to find money-making ideas, buyers and places to post near you."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#4c8dff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api-development-471e.up.railway.app",
      "googleWebClientId": "380557865039-si2rdklefm8jofiklt63f6toh2gu2cck.apps.googleusercontent.com",
      "googleIosClientId": "",
      "router": {},
      "eas": {
        "projectId": "2784b820-d04a-407b-aa7a-feca0b716291"
      }
    },
    "owner": "vakito2345"
  }
}
